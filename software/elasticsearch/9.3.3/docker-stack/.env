# Elastic Stack 版本（Swarm stack 镜像 tag）
ELK_VERSION=9.3.3

# Elasticsearch elastic 用户密码
ELASTIC_PASSWORD=changeme

# Kibana 连接 ES 的 kibana_system 密码
KIBANA_PASSWORD=changeme

# Kibana 加密密钥：部署前自行生成并替换下方占位符（两项各生成一次）
#   openssl rand -base64 32
# 真实密钥勿提交公开仓库；更换后已加密的 Kibana saved objects 将无法解密
# 报表已禁用时无需 REPORTING 密钥
XPACK_ENCRYPTEDSAVEDOBJECTS_ENCRYPTIONKEY=CHANGE_ME_use_openssl_rand_-base64_32
XPACK_REPORTING_ENCRYPTIONKEY=CHANGE_ME_use_openssl_rand_-base64_32
XPACK_SECURITY_ENCRYPTIONKEY=CHANGE_ME_use_openssl_rand_-base64_32
